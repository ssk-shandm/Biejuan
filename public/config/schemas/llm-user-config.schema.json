{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exam.local/schemas/llm-user-config.schema.json",
  "title": "刷题助手 LLM 运行配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "request", "ocr", "privacy"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "baseUrl", "model"],
      "properties": {
        "protocol": {
          "const": "openai-compatible"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "apiKey": {
          "type": "string",
          "description": "桌面端本地配置中的 API 密钥（明文）。不要在公开示例或仓库中填写真实密钥。"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "maxOutputTokens", "timeoutMs"],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      }
    },
    "ocr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "language", "scale", "minTextCharacters"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        },
        "minTextCharacters": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowRemoteProcessing", "confirmBeforeSending"],
      "properties": {
        "allowRemoteProcessing": {
          "type": "boolean",
          "default": false
        },
        "confirmBeforeSending": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
