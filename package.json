{
  "name": "aaa",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/generate-banks.mjs && node scripts/sync-android-icons.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/generate-banks.mjs && node scripts/sync-android-icons.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "node scripts/prepare-public-build.mjs && vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "icons:android": "node scripts/sync-android-icons.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "config:check": "node scripts/check-config.mjs",
    "test": "node --test scripts/test-*.mjs",
    "test:rust": "node scripts/prepare-public-build.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:check": "eslint src vite.config.ts eslint.config.ts --max-warnings 0",
    "release:check": "node scripts/check-release.mjs",
    "verify": "npm run config:check && npm run lint:check && npm run type-check && npm test",
    "verify:release": "npm run verify && npm run build && npm run test:rust && npm run release:check"
  },
  "dependencies": {
    "@tauri-apps/plugin-shell": "^2.3.6",
    "ajv": "^8.20.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "marked": "^18.0.4",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^3.0.3",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.1"
  },
  "description": "鍒烽鍔╂墜 - Vue 3 + Tauri quiz application",
  "license": "MIT",
  "author": "ssk-shandm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssk-shandm/exam.git"
  },
  "homepage": "https://github.com/ssk-shandm/exam#readme",
  "bugs": {
    "url": "https://github.com/ssk-shandm/exam/issues"
  }
}
